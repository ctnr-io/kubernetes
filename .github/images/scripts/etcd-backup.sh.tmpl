#!/bin/bash
# etcd snapshot backup — pre-baked into the K8s node image.
# Run as root on a control-plane node.
# Certificate paths and storage directories are resolved at image build time.
set -euo pipefail

BACKUP_DIR="${ETCD_BACKUP_DIR}"
BACKUP_DATE=$(date +%Y%m%d-%H%M%S)
BACKUP_FILE="$BACKUP_DIR/etcd-snapshot-$BACKUP_DATE.db"

mkdir -p "$BACKUP_DIR"
echo "Creating etcd snapshot: $BACKUP_FILE"

ETCDCTL_API=3 etcdctl \
  --endpoints="https://127.0.0.1:2379" \
  --cacert="${ETCD_CA_FILE}" \
  --cert="${ETCD_CERT_FILE}" \
  --key="${ETCD_KEY_FILE}" \
  snapshot save "$BACKUP_FILE"

# Keep only the 5 most recent snapshots
ls -t "$BACKUP_DIR"/etcd-snapshot-*.db | tail -n +6 | xargs -r rm

echo "Etcd backup completed: $BACKUP_FILE"
